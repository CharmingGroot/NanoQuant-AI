# AI API Keys (둘 중 하나만 필요)
ANTHROPIC_API_KEY=your_anthropic_api_key_here  # Claude 사용 시
OPENAI_API_KEY=your_openai_api_key_here        # GPT 사용 시

# Run mode
SCAN_ONLY=0                 # 1이면 Layer 1+2만 실행 (LLM/거래 없음, API 키 불필요)
USE_NEWS_FOR_TRADING=1      # 1=뉴스를 매수/매도 판단에 활용, 0=뉴스 제외 (지표만 사용)

# Trading parameters
TRADING_CAPITAL=1000          # 초기 투자 금액 (USD)
MAX_POSITION_SIZE=1000           # 종목당 최대 투자액 (USD)
MAX_POSITION_PCT=20           # 종목당 최대 비중 (%)
MAX_POSITIONS=5               # 최대 동시 보유 종목 수
CONFIDENCE_THRESHOLD=65       # 실행 최소 확신도 (65=공격적, 70=보수적)
STOP_LOSS_PERCENT=5           # 손절선 (%)
TAKE_PROFIT_PERCENT=10        # 익절선 (%)
STOP_TAKE_MIN_HOLD_MINUTES=15 # 손절/익절 적용 최소 보유 시간 (분)
SAME_PRICE_SELL_THRESHOLD_PCT=0.3  # 매수가 대비 변동률 이하면 SELL 스킵 (수수료 낭비 방지)

# Trigger (trigger.py)
PRICE_VOLATILITY_THRESHOLD=2.0     # 15분 변동률 임계치 (%)
PRICE_MAX_SCORE=40
NEWS_MAX_SCORE=40
VOLUME_SURGE_MULTIPLIER=1.5       # 평균 거래량 대비 배수
VOLUME_MAX_SCORE=20
TRIGGER_THRESHOLD=25              # 트리거 최소 점수

# DB Viewer (db_viewer.py)
DB_VIEWER_REFRESH_SECONDS=0       # 0=자동 리프레시 비활성화
DB_VIEWER_DECISIONS_PER_PAGE=20
